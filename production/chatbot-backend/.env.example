# Copie para .env e ajuste.

# Postgres — MESMO banco que o ingestion-worker povoou (documents/chunks).
# Porta 5433 (não 5432): a 5432 costuma já estar ocupada por outro Postgres local
# (ex: sacf-postgres-dev) — ver mapeamento em docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/chatbot

# Servidor de embeddings (Ollama) — DEVE ser o mesmo modelo/URL usado na
# ingestão (ingestion-worker/.env), senão a pergunta e os chunks ficam em
# espaços vetoriais diferentes e a busca não funciona.
OLLAMA_BASE_URL=https://qf4s9f8cku7wd3-11434.proxy.runpod.net
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# sacf-ai-worker — o gateway de fila que fala com o LLM de geração de texto.
# Produção (Traefik): https://ai.sacf.io — troque para http://localhost:8011
# se estiver rodando o worker localmente via docker-compose.
AI_WORKER_BASE_URL=https://ai.sacf.io
# Copie o valor de AI_WORKER_SERVICE_TOKEN do .env do sacf-ai-worker (mesmo
# token que o "portal" usa — dá acesso a /v1/jobs, único caminho que respeita
# a prioridade da fila; a ponte síncrona /v1/chat/completions ignora prioridade).
AI_WORKER_SERVICE_TOKEN=
# 1=crítico 2=alto 3=normal(padrão dos outros clientes) 4=baixo 5=mínimo.
# Chat de cliente deve furar a fila de jobs de marketing (que ficam em 3).
AI_WORKER_PRIORITY=2

# Retenção: o bot executa a limpeza automaticamente uma vez por intervalo.
CLEANUP_INACTIVE_DAYS=7
CLEANUP_INTERVAL_HOURS=24

# Bot do Telegram — crie um em https://t.me/BotFather (comando /newbot),
# ele te dá o token na hora. Não dá pra criar isso por API, é manual mesmo.
TELEGRAM_BOT_TOKEN=
