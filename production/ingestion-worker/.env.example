# Copie para .env e ajuste.

# Diretório com os FAQs (os .md crus)
# Este repositório usa exclusivamente a allowlist já higienizada e aprovada.
# Execute o worker a partir de production/ingestion-worker.
FAQ_DIR=../../knowledge/public-faq

# Postgres (precisa da extensão pgvector instalada — o schema.sql cuida do CREATE EXTENSION)
# Use 127.0.0.1 (não localhost): no Windows, localhost tenta IPv6 primeiro e o
# Docker só publica IPv4 — a conexão "funciona" mas demora ~2 min pelo timeout.
# Porta 5433 (não 5432): a 5432 costuma já estar ocupada por outro Postgres local
# (ex: sacf-postgres-dev) — ver mapeamento em docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/chatbot

# Servidor de embeddings (API do Ollama). O worker de ingestão fala DIRETO com o
# Ollama porque embeddings são um processo offline em lote — não passam pela fila
# do sacf-ai-worker, que existe para gerar texto sob demanda.
# É O MESMO servidor Ollama que o sacf-ai-worker usa (veja o .env dele) — NÃO
# rode Ollama na sua máquina. Copie a URL de lá, mas SEM o sufixo /v1 (a API
# nativa de embeddings usada aqui é /api/embeddings, não a OpenAI-compatible).
OLLAMA_BASE_URL=https://qf4s9f8cku7wd3-11434.proxy.runpod.net
# Opcional por enquanto — o endpoint hoje não exige token. Deixe em branco.
# Se/quando o RunPod passar a exigir auth, preencha com o OLLAMA_API_KEY do
# sacf-ai-worker; o código já manda o header sozinho quando isso for preenchido.
OLLAMA_API_KEY=
# bge-m3: multilíngue (~100 idiomas) — necessário porque o Telegram recebe
# perguntas em PT-BR (e possivelmente outros idiomas) sobre uma base em inglês.
# nomic-embed-text (usado antes) só funciona bem com pergunta e conteúdo no
# mesmo idioma — testado e descartado por esse motivo.
EMBEDDING_MODEL=bge-m3
# Dimensão do vetor gerado pelo modelo acima (bge-m3 = 1024).
# Se trocar o modelo, ajuste aqui E recrie a tabela (a dimensão é fixa na coluna).
EMBEDDING_DIM=1024
