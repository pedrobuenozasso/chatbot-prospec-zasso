FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY db ./db
COPY monitoring ./monitoring

RUN chown -R node:node /app

USER node

ENV NODE_ENV=production
ENV MONITORING_HOST=0.0.0.0
ENV MONITORING_PORT=3100

EXPOSE 3100

HEALTHCHECK --interval=30s --timeout=7s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3100/healthz >/dev/null || exit 1

CMD ["node", "monitoring/start.mjs"]
