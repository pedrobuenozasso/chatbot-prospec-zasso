TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
SACF_AI_BASE_URL=https://ai.sacf.io
SACF_AI_SERVICE_TOKEN=
SACF_AI_MODEL=qwen2.5:14b
SACF_AI_TENANT_LABEL=Zasso
SACF_AI_PRIORITY=3
SACF_AI_JOB_TIMEOUT_MS=90000
# API interna chamada pelo n8n. Gere com: openssl rand -hex 32
CHATBOT_API_TOKEN=
# Use 0.0.0.0 somente em rede Docker/VPC protegida ou atrás de proxy HTTPS.
CHATBOT_API_HOST=127.0.0.1
CHATBOT_API_PORT=3000
CHATBOT_API_REQUEST_TIMEOUT_MS=120000
CHATBOT_API_RATE_LIMIT_MAX_REQUESTS=12
CHATBOT_API_RATE_LIMIT_WINDOW_MS=60000
# Número do comercial no formato internacional, somente dígitos (Brasil: 55 + DDD + número).
COMMERCIAL_WHATSAPP_NUMBER=5511967702212
# A validação de uma resposta de qualificação deve cair rapidamente no fallback.
QUALIFICATION_AI_TIMEOUT_MS=12000
RAG_RETRIEVAL_MODE=lexical
MIN_RETRIEVAL_SCORE=0.25
MAX_QUESTION_CHARS=800
MAX_CONTEXT_CHARS=12000
MAX_ANSWER_CHARS=1400
# Respostas comerciais normais ficam curtas; só aumente se houver necessidade real.
PREFERRED_ANSWER_CHARS=700
TELEGRAM_RATE_LIMIT_MAX_REQUESTS=8
TELEGRAM_RATE_LIMIT_WINDOW_MS=60000
# Pausa curta com indicador “digitando” antes de cada resposta do bot.
REPLY_TYPING_MIN_MS=900
REPLY_TYPING_MAX_MS=2200
# Após este período sem contato, o mesmo número volta ao fluxo como novo lead.
CONVERSATION_INACTIVITY_DAYS=15
# Texto integral das conversas no PostgreSQL. Resumos comerciais têm retenção própria.
MESSAGE_RETENTION_DAYS=15
RETENTION_SWEEP_INTERVAL_HOURS=24
# Referências ficam ocultas na conversa para uma experiência mais natural.
# Use true somente em validações internas.
SHOW_SOURCES=false

# Persistência operacional. Mantenha false até o Cloud SQL Auth Proxy estar
# autenticado e a senha real ter sido instalada somente na VPS.
DATABASE_ENABLED=false
DATABASE_REQUIRED=false
DATABASE_HOST=cloudsql-proxy-pool
DATABASE_PORT=5432
DATABASE_SCHEMA=public
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000

# Cloud SQL. Não versione a senha nem o JSON da conta de serviço.
CLOUDSQL_INSTANCE_CONNECTION_NAME=
CLOUDSQL_DB_NAME=
CLOUDSQL_DB_USER=
CLOUDSQL_DB_PASSWORD=
CLOUDSQL_DB_SCHEMA=public

# Opcional: use apenas quando houver um Ollama acessível diretamente.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Painel administrativo. Gere os dois segredos separadamente com:
# openssl rand -hex 32
MONITORING_PASSWORD_PEPPER=
MONITORING_ENCRYPTION_KEY=
MONITORING_PROXY_TOKEN=
MONITORING_REQUIRE_PROXY=false
MONITORING_PUBLIC_ORIGIN=http://localhost:3100
MONITORING_ALLOWED_EMAIL_DOMAIN=zasso.com.br
# Se preenchido, substitui a regra por domínio e aceita somente estes endereços.
MONITORING_ALLOWED_EMAILS=pedro.bueno@zasso.com.br,rodrigo.conilho@zasso.com.br
MONITORING_EMAIL_LOGIN_ENABLED=true
MONITORING_EMAIL_CODE_MINUTES=10
MONITORING_EMAIL_CODE_MAX_ATTEMPTS=5
MONITORING_EMAIL_CODE_MAX_REQUESTS=3
MONITORING_MAIL_SERVICE_URL=http://sacf-mail-service:8015
MONITORING_MAIL_SERVICE_TOKEN=
MONITORING_SESSION_HOURS=8
MONITORING_AUDIT_RETENTION_DAYS=180
MONITORING_HEALTH_RETENTION_DAYS=90
MONITORING_DATABASE_POOL_MAX=5
MONITORING_CHATBOT_HEALTH_URL=http://zasso-chatbot:3000/healthz
MONITORING_N8N_HEALTH_URL=http://n8n:5678/healthz
MONITORING_EVOLUTION_HEALTH_URL=
MONITORING_EVOLUTION_API_KEY=
MONITORING_EVENTS_PATH=/chatbot-logs/events.jsonl
# Começa desligada. Quando ativada, as transcrições são anonimizadas antes da análise.
MONITORING_AI_ANALYSIS_ENABLED=false
MONITORING_AI_TIMEOUT_MS=120000
